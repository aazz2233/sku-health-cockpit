# ============================================================
# 本地 / 演示环境变量示例
# 复制一份为 .env 后填写；.env 不会提交到仓库
# ============================================================

# ---- 数据与存储 ----
# 默认为本地 DuckDB 文件（零配置）；需要 MySQL 时改成下面的 DSN
DUCKDB_PATH=data/warehouse/cockpit.duckdb

# MySQL（可选，docker compose --profile mysql 或本机 MySQL 8）
# MYSQL_DSN=mysql+pymysql://user:password@127.0.0.1:3306/sku_cockpit?charset=utf8mb4

# ---- LLM（AI 归因层）----
# provider: openai | anthropic | deepseek | mock（mock 不联网，回放录制响应）
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# 让 litellm 用内置价目表，避免每次 import 去 GitHub 拉取（本机实测会超时重试 3 次）
LITELLM_LOCAL_MODEL_COST_MAP=True

# ---- 演示数据 ----
DATA_SEED=20241119
DATA_SHOPS=3
DATA_SKUS=200
DATA_DAYS=90

# ---- 通知（日报推送，可选）----
WEBHOOK_URL=
