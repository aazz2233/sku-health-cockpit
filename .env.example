# ============================================================
# 环境变量示例
# 复制为 .env 后填写；.env 已在 .gitignore 里，不会提交
# ============================================================

# ---- 存储 ----
# 主存储是 MySQL 8（P1 之后所有分层都走它）
MYSQL_DSN=mysql+pymysql://cockpit:your_password@127.0.0.1:3306/sku_cockpit?charset=utf8mb4

# ---- LLM（AI 归因层，P4）----
# mock = 不联网，走模板化解释；deepseek/openai = 真实调用
LLM_PROVIDER=mock
LLM_MODEL=deepseek-flash
# 国内模型走 OpenAI 兼容协议时需要显式给 base_url
LLM_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# 推理模型会把 token 预算全用在思考上、正文为空，这个任务不需要
LLM_DISABLE_THINKING=True
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# 让 litellm 用内置价目表，避免每次 import 去 GitHub 拉取（本机实测会超时重试 3 次）
LITELLM_LOCAL_MODEL_COST_MAP=True

# ---- 演示数据 ----
DATA_SEED=20241119
DATA_SHOPS=3
DATA_SKUS=200
DATA_DAYS=90

# ---- 通知（可选）----
WEBHOOK_URL=
